@model List<BrandModel>

<h1>Lista de Marcas</h1>

<a class="btn btn-primary" asp-action="BrandAdd" asp-controller="Brand">Agregar Marca</a>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Activo</th>
            <th>Fecha de Creación</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var brand in Model)
        {
            <tr>
                <td>@brand.Name</td>
                <td>@brand.Description</td>
                <td> @if (@brand.Active)
                    {
                        <a>Sí C:</a>
                    } else {
                        <a>No :C</a>
                    }
                </td>
                <td>@brand.CreationDate</td>
                <td>
                    <a class="btn btn-secondary"
                    asp-action="BrandEdit"
                    asp-controller="Brand"
                    asp-route-id="@brand.Id">Editar</a>
                    <a class="btn btn-danger"
                    asp-action="BrandDelete"
                    asp-controller="Brand"
                    asp-route-id="@brand.Id">Borrar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
